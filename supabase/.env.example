# ============================================================
# SERVER — Edge Functions / scripts locais.
# Copie para supabase/.env e preencha. Nunca versione o .env.
# NADA aqui pode ser prefixado com VITE_ nem importado de dentro de src/.
# ============================================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# IGNORA RLS — tratar como senha de root do banco.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
