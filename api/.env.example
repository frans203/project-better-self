# API (NestJS). Copie para api/.env e preencha. O .env NUNCA vai pro git.
# Server-side: nada aqui tem prefixo VITE_ e nada daqui pode ir pro front.

NODE_ENV=development
PORT=3000

# Origem do front. Vira o CORS e, no H3, a base da URL de volta do checkout.
APP_URL=http://localhost:5173
# Origens extras liberadas no CORS, separadas por virgula (ex.: preview da Vercel). Opcional.
CORS_ORIGINS=

# Projeto Supabase. A API valida o JWT do usuario pelo JWKS publico:
#   ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Exige chaves de assinatura assimetricas (Settings > JWT Keys). Projeto ainda no
# segredo HS256 legado devolve JWKS vazio e todo request vira UNAUTHENTICATED.
SUPABASE_URL=https://<projeto-de-dev>.supabase.co

# Connection string do Postgres (Settings > Database). Usuario de servico: ignora RLS,
# por isso todo repositorio filtra por userId (SAAS_PLAN §5.3).
# Em dev, use o projeto Supabase de DEV (H2), nunca o banco do app publicado.
DATABASE_URL=postgresql://postgres:<senha>@db.<projeto-de-dev>.supabase.co:5432/postgres
